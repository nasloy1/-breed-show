# === Tokens ===
# Option A: Two bots (recommended for production)
BOT_TOKEN_CATS=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_TOKEN_DOGS=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B: Single bot
# BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BOT_MODE=cats

# === Bot usernames (for deeplinks in /tg/config) ===
BOT_USERNAME_CATS=kittens_buy_bot
BOT_USERNAME_DOGS=puppies_buy_bot

# === Mini App URL (your GitHub Pages URL) ===
MINI_APP_URL=https://yourusername.github.io/breed-show

# === Server ===
PORT=8080
PUBLIC_URL=https://yourapp.up.railway.app
DB_PATH=breed_show.db

# === Dev ===
# Set to true to skip initData HMAC verification and use user_id=0 as fallback
SKIP_INITDATA_CHECK=false
